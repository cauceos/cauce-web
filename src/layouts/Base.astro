---
import '../styles/global.css';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { lang, title, description, ogImage } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';

// Per-locale Open Graph image (overridable via the ogImage prop).
const ogImageUrl =
  ogImage ??
  (lang === 'es'
    ? 'https://cauce.dev/og-image-es.png'
    : 'https://cauce.dev/og-image-en.png');
const ogImageAlt =
  lang === 'es'
    ? 'Cauce — Infraestructura abierta para agentes de IA'
    : 'Cauce — Open infrastructure for AI agents';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content="https://cauce.dev" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cauce_ai" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': 'https://cauce.dev/#organization',
            name: 'Cauce',
            url: 'https://cauce.dev',
            logo: {
              '@type': 'ImageObject',
              url: 'https://cauce.dev/logos/cauce-symbol-dark.svg',
              width: 512,
              height: 512,
            },
            description:
              lang === 'es'
                ? 'Plataforma open source europea para construir, desplegar y escalar agentes de IA robustos.'
                : 'European open source platform to build, deploy and scale robust AI agents.',
            sameAs: ['https://github.com/cauceos', 'https://x.com/cauce_ai'],
          },
          {
            '@type': 'WebSite',
            '@id': 'https://cauce.dev/#website',
            url: lang === 'es' ? 'https://cauce.dev/es/' : 'https://cauce.dev/',
            name: 'Cauce',
            description:
              lang === 'es'
                ? 'Infraestructura abierta para agentes de IA'
                : 'Open infrastructure for AI agents',
            publisher: { '@id': 'https://cauce.dev/#organization' },
            inLanguage: lang === 'es' ? 'es-ES' : 'en-US',
          },
          {
            '@type': 'SoftwareApplication',
            '@id': 'https://cauce.dev/#software',
            name: 'Cauce',
            applicationCategory: 'DeveloperApplication',
            operatingSystem: 'Cross-platform',
            description:
              lang === 'es'
                ? 'Infraestructura open source para construir agentes de IA productivos en Spring Boot.'
                : 'Open source infrastructure to build production AI agents on Spring Boot.',
            offers: {
              '@type': 'Offer',
              price: '0',
              priceCurrency: 'EUR',
            },
            softwareVersion: '0.1.0-alpha',
            license: 'https://opensource.org/licenses/MIT',
            url: 'https://github.com/cauceos',
          },
        ],
      })}
    />

    <link rel="canonical" href={Astro.url} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0E0F0D" />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="en" href="https://cauce.dev/" />
    <link rel="alternate" hreflang="es" href="https://cauce.dev/es/" />
    <link rel="alternate" hreflang="x-default" href="https://cauce.dev/" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      // Scroll reveal: adds .is-visible to .reveal elements when they
      // enter the viewport. Runs once per element (unobserve after reveal).
      const reveals = document.querySelectorAll('.reveal');

      if (reveals.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        reveals.forEach((el) => observer.observe(el));
      } else {
        // Fallback: si no hay IntersectionObserver, mostrar todo directamente
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
