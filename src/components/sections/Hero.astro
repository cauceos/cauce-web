---
// Hero.astro — brand moment. Headline + CTAs + stats on the left,
// breathing Estrato symbol on the right, ambient glows behind everything.
import Logo from '../Logo.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const stats = [
  { value: 'Spring Boot', label: 'Backend sólido' },
  { value: 'Multi-tenant', label: 'Desde el primer commit' },
  { value: 'Open source', label: 'Sin lock-in' },
];
---

<section id="inicio" class="relative overflow-hidden min-h-screen pt-32 pb-20">
  <!-- Ambient glows (behind content, z-0) -->
  <div
    class="pointer-events-none absolute -top-[200px] -right-[200px] w-[700px] h-[700px] rounded-full"
    style="background: radial-gradient(circle, rgba(45,212,192,0.08), transparent 70%);"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-[100px] -left-[100px] w-[500px] h-[500px] rounded-full"
    style="background: radial-gradient(circle, rgba(78,139,98,0.05), transparent 70%);"
  >
  </div>

  <!-- Main content (above glows) -->
  <div class="relative z-10 max-w-content mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 min-[960px]:grid-cols-[1fr_380px] gap-20 items-center">
      <!-- Left column -->
      <div>
        <div class="mb-9">
          <Eyebrow withDot color="teal">OPEN SOURCE · BUILDING IN PUBLIC</Eyebrow>
        </div>

        <h1
          class="font-display text-[clamp(52px,6.5vw,92px)] tracking-[-3px] leading-[0.98] mb-7"
        >
          La infraestructura<br />
          por donde <em class="italic text-teal-500">fluye</em><br />
          <span class="text-stone-600">tu IA.</span>
        </h1>

        <p
          class="font-body text-lg text-[#C8CAC2] leading-relaxed font-light max-w-[520px] mb-11"
        >
          Cauce es la plataforma <strong class="text-stone-100 font-medium"
            >open source europea</strong
          > para construir, desplegar y escalar agentes de IA robustos. Sin vendor
          lock-in. Sin vende-humos. Hecho para durar.
        </p>

        <div class="flex flex-wrap items-center gap-3.5">
          <Button variant="primary" size="md" href="#waitlist">Únete a la waitlist →</Button>
          <Button variant="ghost" size="md" href="#que-es">Ver el proyecto</Button>
        </div>

        <div class="mt-14 pt-10 border-t border-[var(--border)] flex flex-wrap gap-8">
          {
            stats.map((s) => (
              <div>
                <span class="block font-mono text-[22px] text-teal-400 mb-1">{s.value}</span>
                <span class="font-body text-xs text-stone-400">{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right column: breathing symbol (hidden under 960px) -->
      <div class="hidden min-[960px]:flex items-center justify-center">
        <div class="relative">
          <div
            class="absolute inset-[-40px] rounded-full pointer-events-none"
            style="background: radial-gradient(circle, rgba(45,212,192,0.08), transparent 70%);"
          >
          </div>
          <div class="hero-mark-breathe relative">
            <Logo size={320} variant="dark" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-mark-breathe {
    animation: breathe 4s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }
</style>
