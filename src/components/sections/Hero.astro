---
// Hero.astro — brand moment. Headline + CTAs + stats on the left,
// breathing Estrato symbol on the right, ambient glows behind everything.
import Logo from '../Logo.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: t('hero.stat1.value'), label: t('hero.stat1.label') },
  { value: t('hero.stat2.value'), label: t('hero.stat2.label') },
  { value: t('hero.stat3.value'), label: t('hero.stat3.label') },
];

// Split the subtitle around the bold phrase so it can be emphasised inline.
const [subtitleBefore, subtitleAfter] = t('hero.subtitle').split(t('hero.subtitle.bold'));
---

<section id="inicio" class="relative overflow-hidden min-h-screen pt-32 pb-20">
  <!-- Ambient glows (behind content, z-0) -->
  <div
    class="pointer-events-none absolute -top-[200px] -right-[200px] w-[700px] h-[700px] rounded-full"
    style="background: radial-gradient(circle, rgba(45,212,192,0.08), transparent 70%);"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-[100px] -left-[100px] w-[500px] h-[500px] rounded-full"
    style="background: radial-gradient(circle, rgba(78,139,98,0.05), transparent 70%);"
  >
  </div>

  <!-- Main content (above glows) -->
  <div class="relative z-10 container-page">
    <!-- Eyebrow sits above the grid so the H1 and the symbol share the same top line -->
    <div class="mb-9">
      <Eyebrow withDot color="teal">{t('hero.eyebrow')}</Eyebrow>
    </div>

    <div class="grid grid-cols-1 min-[960px]:grid-cols-[1fr_380px] gap-20 items-start">
      <!-- Left column -->
      <div>
        <h1
          class="font-display text-[clamp(52px,6.5vw,92px)] tracking-[-3px] leading-[0.98] mb-7"
        >
          {t('hero.title.line1')}<br />
          {t('hero.title.line2.pre')} <em class="italic text-teal-500">{t('hero.title.line2.emphasis')}</em><br />
          <span class="text-stone-600">{t('hero.title.line3')}</span>
        </h1>

        <p
          class="font-body text-lg text-[#C8CAC2] leading-relaxed font-light max-w-[520px] mb-11"
        >
          {subtitleBefore}<strong class="text-stone-100 font-medium">{t('hero.subtitle.bold')}</strong>{subtitleAfter}
        </p>

        <div class="flex flex-wrap items-center gap-3.5">
          <Button variant="primary" size="md" href="#waitlist">{t('hero.cta.primary')}</Button>
          <Button variant="ghost" size="md" href="#que-es">{t('hero.cta.secondary')}</Button>
        </div>

        <div class="mt-14 pt-10 border-t border-[var(--border)] flex flex-wrap gap-8">
          {
            stats.map((s) => (
              <div>
                <span class="block font-mono text-[22px] text-teal-400 mb-1">{s.value}</span>
                <span class="font-body text-xs text-stone-400">{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right column: breathing symbol (hidden under 960px), top-aligned with the H1 -->
      <div class="hidden min-[960px]:flex items-start justify-center">
        <div class="relative">
          <div
            class="absolute inset-[-40px] rounded-full pointer-events-none"
            style="background: radial-gradient(circle, rgba(45,212,192,0.08), transparent 70%);"
          >
          </div>
          <div class="hero-mark-breathe relative">
            <Logo size={320} variant="dark" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-mark-breathe {
    animation: breathe 4s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }
</style>
