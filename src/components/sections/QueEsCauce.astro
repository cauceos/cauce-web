---
// QueEsCauce.astro — the ONLY light-theme section.
// variant="light" on Section flips the semantic vars (--bg/--text) via
// .light-section, so the whole block turns cream (#ECEEE8) with dark text.
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const features = [
  {
    icon: '🌊',
    borderColor: 'border-t-teal-600',
    iconBg: 'bg-teal-500/10',
    title: 'Multicanal desde el primer día',
    body: 'WhatsApp, Telegram, voz y web chat en un solo runtime. Sin duplicar lógica de negocio. Sin mantener cuatro integraciones por separado. El cauce recibe todos los flujos.',
    tag: 'cauce-channels',
    tagColor: 'text-teal-600 border-teal-600/30 bg-teal-500/5',
  },
  {
    icon: '🧠',
    borderColor: 'border-t-moss-500',
    iconBg: 'bg-moss-500/10',
    title: 'Memoria y contexto persistente',
    body: 'Los agentes recuerdan. Memoria por conversación, por usuario y por tenant. Soporte para múltiples LLMs intercambiables sin tocar el código del agente.',
    tag: 'cauce-memory',
    tagColor: 'text-moss-500 border-moss-500/30 bg-moss-500/5',
  },
  {
    icon: '🏗️',
    borderColor: 'border-t-slate-500',
    iconBg: 'bg-slate-500/10',
    title: 'Multi-tenant y observable',
    body: 'Diseñado para que una sola instancia sirva a muchos clientes. Métricas, trazas y logs integrados. Cada tenant aislado desde la arquitectura, no como añadido posterior.',
    tag: 'cauce-core',
    tagColor: 'text-slate-500 border-slate-500/30 bg-slate-500/5',
  },
];

const cardBase =
  'bg-white border border-stone-200 border-t-[3px] px-8 py-9 transition-all duration-200 hover:shadow-[0_8px_32px_rgba(0,0,0,0.08)] hover:-translate-y-0.5';
---

<Section id="que-es" variant="light">
  <!-- Eyebrow — teal-600 for contrast on the light background -->
  <div class="mb-5">
    <Eyebrow color="teal" class="text-teal-600">QUÉ ES CAUCE</Eyebrow>
  </div>

  <!-- H2 -->
  <h2
    class="font-display text-[clamp(36px,4.5vw,60px)] tracking-[-2px] leading-[1.05] mb-5 text-stone-950"
  >
    Infraestructura real.<br />
    <em class="italic text-teal-600">No demos.</em>
  </h2>

  <!-- Subtitle -->
  <p class="font-body text-base text-stone-600 leading-relaxed max-w-[560px] mb-16">
    Una plataforma modular que conecta tus canales, gestiona la memoria de tus
    agentes y expone todo vía API. Construida sobre Spring Boot, pensada para
    consultoras que entregan proyectos reales a clientes reales.
  </p>

  <!-- 3 feature cards (glued: 3px divider + shared outer corners) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-[3px]">
    {
      features.map((f, i) => {
        const corner =
          i === 0
            ? 'rounded-l-2xl rounded-r-none'
            : i === features.length - 1
              ? 'rounded-r-2xl rounded-l-none'
              : 'rounded-none';
        return (
          <div class:list={[cardBase, f.borderColor, corner]}>
            <div
              class:list={[
                'w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-5',
                f.iconBg,
              ]}
            >
              {f.icon}
            </div>
            <h3 class="text-[15px] font-semibold text-stone-950 mb-2.5 tracking-tight">
              {f.title}
            </h3>
            <p class="text-[13px] text-stone-600 leading-relaxed mb-5">{f.body}</p>
            <span
              class:list={[
                'inline-flex font-mono text-[10px] px-3 py-1 rounded-full border',
                f.tagColor,
              ]}
            >
              {f.tag}
            </span>
          </div>
        );
      })
    }
  </div>
</Section>
