---
// Problema.astro — "El problema": 4 stacked pain points + sticky quote.
// Uses the shared Section wrapper so it inherits the unified 1320px grid.
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const painPoints = [
  { icon: '💸', title: t('problem.pain1.title'), body: t('problem.pain1.body') },
  { icon: '🔒', title: t('problem.pain2.title'), body: t('problem.pain2.body') },
  { icon: '🧩', title: t('problem.pain3.title'), body: t('problem.pain3.body') },
  { icon: '🕳️', title: t('problem.pain4.title'), body: t('problem.pain4.body') },
];

const cardBase =
  'bg-[var(--color-stone-900)] border border-[var(--border)] px-7 py-6 flex items-start gap-4 transition-all duration-200 hover:bg-[var(--color-stone-800)] hover:border-[rgba(224,90,78,0.2)]';
---

<Section id="problema">
  <!-- Eyebrow -->
  <div class="mb-5 reveal">
    <Eyebrow color="teal">{t('problem.eyebrow')}</Eyebrow>
  </div>

  <!-- H2 -->
  <h2 class="font-display text-[clamp(36px,4.5vw,60px)] tracking-[-2px] leading-none mb-16 reveal">
    {t('problem.title.line1')}<br />
    <em class="italic text-teal-500">{t('problem.title.emphasis')}</em><br />
    <span class="text-stone-600">{t('problem.title.line3')}</span>
  </h2>

  <!-- Grid: pain points + sticky quote -->
  <div class="grid grid-cols-1 md:grid-cols-[1fr_440px] gap-12 md:gap-20 items-start reveal">
    <!-- Left: stacked pain points (2px gap = thin divider, shared corners) -->
    <div class="flex flex-col gap-[2px]">
      {
        painPoints.map((p, i) => {
          const corner =
            i === 0
              ? 'rounded-t-xl rounded-b-none'
              : i === painPoints.length - 1
                ? 'rounded-b-xl rounded-t-none'
                : 'rounded-none';
          return (
            <div class:list={[cardBase, corner]}>
              <span class="text-lg flex-shrink-0 mt-0.5 opacity-70">{p.icon}</span>
              <div>
                <h3 class="text-sm font-semibold text-stone-100 mb-1.5">{p.title}</h3>
                <p class="text-[13px] text-stone-400 leading-relaxed">{p.body}</p>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Right: sticky quote -->
    <div
      class="sticky top-24 bg-[var(--color-stone-900)] border border-[var(--border)] rounded-2xl p-10 flex flex-col gap-7"
    >
      <div class="font-display text-[64px] text-teal-500 leading-[0.4] opacity-40">&ldquo;</div>
      <div class="flex flex-col gap-5">
        <p class="font-display text-[22px] tracking-[-0.5px] leading-snug font-light text-stone-100">
          {t('problem.quote.part1')}
        </p>
        <p class="font-display text-[22px] tracking-[-0.5px] leading-snug font-light text-stone-100">
          {t('problem.quote.part2')}{' '}
          <em class="italic text-teal-500">{t('problem.quote.emphasis')}</em>
        </p>
      </div>
      <div
        class="font-mono text-[10px] tracking-[2px] uppercase text-stone-400 pt-5 border-t border-[var(--border)]"
      >
        {t('problem.quote.author')}
      </div>
    </div>
  </div>
</Section>
