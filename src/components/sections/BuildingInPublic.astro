---
// BuildingInPublic.astro — dark. Manifesto (left) + X-style devlog feed (right).
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Logo from '../Logo.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const manifesto = [
  { num: '01', bold: t('bip.manifesto1.bold'), rest: t('bip.manifesto1.rest') },
  { num: '02', bold: t('bip.manifesto2.bold'), rest: t('bip.manifesto2.rest') },
  { num: '03', bold: t('bip.manifesto3.bold'), rest: t('bip.manifesto3.rest') },
  { num: '04', bold: t('bip.manifesto4.bold'), rest: t('bip.manifesto4.rest') },
];

interface Devlog {
  meta: string;
  text: string;
  highlight: string | null;
  highlightColor: 'teal' | 'moss' | null;
  after: string | null;
}

const devlogs: Devlog[] = [
  {
    meta: t('bip.devlog4.meta'),
    text: t('bip.devlog4.text'),
    highlight: t('bip.devlog4.highlight'),
    highlightColor: 'teal',
    after: t('bip.devlog4.after'),
  },
  {
    meta: t('bip.devlog3.meta'),
    text: t('bip.devlog3.text'),
    highlight: t('bip.devlog3.highlight'),
    highlightColor: 'moss',
    after: t('bip.devlog3.after'),
  },
  {
    meta: t('bip.devlog1.meta'),
    text: t('bip.devlog1.text'),
    highlight: null,
    highlightColor: null,
    after: null,
  },
];
---

<Section id="bip">
  <!-- Eyebrow -->
  <div class="mb-5 reveal">
    <Eyebrow color="teal">{t('bip.eyebrow')}</Eyebrow>
  </div>

  <!-- H2 -->
  <h2 class="font-display text-[clamp(36px,4.5vw,60px)] tracking-[-2px] leading-none mb-16 reveal">
    {t('bip.title.line1')}<br />
    <em class="italic text-teal-500">{t('bip.title.emphasis')}</em>
  </h2>

  <!-- Grid: manifesto + feed -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
    <!-- Left: manifesto -->
    <div class="reveal">
      <div class="flex flex-col gap-6">
        {
          manifesto.map((item) => (
            <div class="flex gap-4 items-start">
              <span class="font-mono text-[10px] text-teal-500 tracking-[2px] pt-1 flex-shrink-0 w-7">
                {item.num}
              </span>
              <p class="text-[15px] text-[#C8CAC2] leading-relaxed font-light">
                <strong class="text-stone-100 font-medium">{item.bold}</strong>
                {' '}
                {item.rest}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-10">
        <Button variant="ghost" size="md" href="https://github.com/cauceos">
          {t('bip.cta')}
        </Button>
      </div>
    </div>

    <!-- Right: devlog feed -->
    <div
      class="bg-[var(--color-stone-900)] border border-[var(--border)] rounded-2xl overflow-hidden reveal"
    >
      <!-- Feed header -->
      <div class="px-7 py-5 border-b border-[var(--border)] flex items-center gap-3">
        <div
          class="w-9 h-9 rounded-full bg-[var(--color-stone-950)] border border-[var(--border)] flex items-center justify-center flex-shrink-0"
        >
          <Logo size={20} />
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="text-[13px] font-semibold text-stone-100">Cauce OS</span>
          <span class="font-mono text-[10px] text-stone-400 tracking-wide">
            @cauce_ai · cauce.dev
          </span>
        </div>
      </div>

      <!-- Feed posts -->
      <div class="px-7 py-5 flex flex-col gap-4">
        {
          devlogs.map((post) => (
            <div class="p-4 bg-[var(--color-stone-800)] rounded-xl border border-[var(--border)]">
              <div class="font-mono text-[9px] text-stone-600 tracking-[1px] mb-2">
                {post.meta}
              </div>
              <p class="text-[13px] text-stone-300 leading-relaxed">
                {post.text}
                {post.highlight && (
                  <span
                    class:list={[
                      'ml-1',
                      post.highlightColor === 'teal' ? 'text-teal-400' : 'text-moss-400',
                    ]}
                  >
                    {post.highlight}
                  </span>
                )}
                {post.after && <span class="ml-1">{post.after}</span>}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
