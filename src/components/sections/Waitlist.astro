---
// Waitlist.astro — dark with a premium teal-accented card. Email form wired
// to a Loops.so newsletter form, with loading and error states.
import Section from '../ui/Section.astro';
import Logo from '../Logo.astro';

const loopsUrl = import.meta.env.PUBLIC_LOOPS_FORM_URL;

if (!loopsUrl) {
  console.warn('[Waitlist] PUBLIC_LOOPS_FORM_URL is not defined in .env.local');
}
---

<Section id="waitlist">
  <!-- Premium card -->
  <div
    class="relative overflow-hidden max-w-[840px] mx-auto rounded-3xl border border-[rgba(45,212,192,0.15)] bg-[linear-gradient(135deg,rgba(45,212,192,0.06)_0%,rgba(78,139,98,0.04)_60%,transparent_100%)] px-10 py-20 md:px-20 md:py-24 text-center"
  >
    <!-- Decorative top glow -->
    <div
      class="absolute -top-20 left-1/2 -translate-x-1/2 w-[400px] h-[300px] rounded-full bg-[radial-gradient(circle,rgba(45,212,192,0.08)_0%,transparent_70%)] pointer-events-none"
    >
    </div>

    <!-- Content (above glow) -->
    <div class="relative z-10">
      <!-- Logo -->
      <div class="flex justify-center mb-8">
        <Logo size={72} />
      </div>

      <!-- H2 -->
      <h2 class="font-display text-[clamp(36px,4vw,56px)] tracking-[-2px] leading-[1.05] mb-4">
        Sé el primero en<br />
        probar <em class="italic text-teal-500">Cauce.</em>
      </h2>

      <!-- Subtitle -->
      <p
        class="font-body text-base text-[#C8CAC2] leading-relaxed font-light max-w-[480px] mx-auto mb-11"
      >
        Estamos construyendo en abierto. Cuando lancemos la primera versión
        pública, los de la lista serán los primeros en acceder.
      </p>

      <!-- Form -->
      <form
        id="waitlist-form"
        action={loopsUrl}
        method="POST"
        class="flex flex-col sm:flex-row gap-2.5 max-w-[440px] mx-auto mb-4"
      >
        <input
          type="email"
          name="email"
          required
          placeholder="tu@email.com"
          class="flex-1 bg-[var(--color-stone-900)] border border-[var(--border)] rounded-lg px-5 py-3.5 font-body text-sm text-stone-100 placeholder:text-stone-600 outline-none transition-colors duration-200 focus:border-teal-500/40"
        />
        <button
          type="submit"
          id="waitlist-submit"
          class="bg-teal-500 text-stone-950 px-6 py-3.5 rounded-lg font-body text-sm font-semibold transition-all duration-200 hover:bg-teal-400 hover:-translate-y-px whitespace-nowrap cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
        >
          <span data-label="default">Apúntame →</span>
          <span data-label="loading" class="hidden">Enviando…</span>
        </button>
      </form>

      <!-- Success message (hidden by default) -->
      <div
        id="waitlist-success"
        class="hidden items-center justify-center gap-2.5 font-mono text-[13px] text-moss-400 mb-4"
      >
        <span>✓</span> Apuntado. Te avisamos cuando abramos.
      </div>

      <!-- Error message (hidden by default) -->
      <div
        id="waitlist-error"
        class="hidden items-center justify-center gap-2.5 font-mono text-[12px] text-[#E05A4E] mb-4"
      >
        <span>✕</span> Algo ha fallado. Inténtalo en un momento.
      </div>

      <!-- Note -->
      <p class="font-mono text-[10px] text-stone-600 tracking-wide">
        Sin spam. Solo cuando haya algo que merezca la pena.
      </p>
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('waitlist-success');
  const errorEl = document.getElementById('waitlist-error');
  const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  const labelDefault = submitBtn?.querySelector('[data-label="default"]') as HTMLElement | null;
  const labelLoading = submitBtn?.querySelector('[data-label="loading"]') as HTMLElement | null;

  if (form && success && errorEl && submitBtn && labelDefault && labelLoading) {
    const input = form.querySelector('input[name="email"]') as HTMLInputElement;

    const showError = () => {
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
    };

    const hideError = () => {
      errorEl.classList.add('hidden');
      errorEl.classList.remove('flex');
    };

    const setLoading = (loading: boolean) => {
      submitBtn.disabled = loading;
      labelDefault.classList.toggle('hidden', loading);
      labelLoading.classList.toggle('hidden', !loading);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      input.style.borderColor = '';

      const email = input.value.trim();

      // Validación básica de formato
      if (!email || !email.includes('@') || !email.includes('.')) {
        input.style.borderColor = 'rgba(224,90,78,0.5)';
        return;
      }

      // Verificar que tenemos endpoint
      if (!form.action || form.action === window.location.href) {
        console.error('[Waitlist] No action URL configured');
        showError();
        return;
      }

      setLoading(true);

      try {
        // Loops espera FormData con el campo "email"
        const formData = new FormData();
        formData.append('email', email);

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        if (!response.ok) {
          throw new Error(`Loops responded with ${response.status}`);
        }

        // Éxito: ocultar form, mostrar mensaje
        form.style.display = 'none';
        success.classList.remove('hidden');
        success.classList.add('flex');
      } catch (err) {
        console.error('[Waitlist] Submission error:', err);
        setLoading(false);
        showError();
      }
    });
  }
</script>
