---
import Logo from '../Logo.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Absolute so the link also works from /log.
const home = `${getLocalizedPath('/', lang)}#inicio`;
---

<footer class="border-t border-[var(--border)] py-12 mt-12">
  <div class="container-page">
    <div class="flex items-center justify-between flex-wrap gap-5">
      <!-- Marca -->
      <div class="flex items-center gap-4">
        <a href={home} class="flex items-center gap-2.5">
          <Logo size={22} />
          <span class="font-display text-base text-stone-400 tracking-tight">
            Cau<em class="italic text-teal-500">ce</em>
          </span>
        </a>
        <span class="w-px h-4 bg-[var(--border)]"></span>
        <span class="font-mono text-[10px] text-stone-400 tracking-wider">{t('footer.by')}</span>
      </div>

      <!-- Links + crédito -->
      <div class="flex items-center gap-6 flex-wrap">
        <a
          href="mailto:joseluisrv.dev@gmail.com"
          class="font-body text-xs text-stone-400 hover:text-stone-200 transition-colors duration-200"
        >
          {t('footer.email')}
        </a>
        <a
          href="https://github.com/cauceos"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-xs text-stone-400 hover:text-stone-200 transition-colors duration-200"
        >
          GitHub
        </a>
        <a
          href="https://x.com/cauce_ai"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-xs text-stone-400 hover:text-stone-200 transition-colors duration-200"
        >
          X
        </a>
        <span class="font-mono text-[10px] text-stone-400 tracking-wider">{t('footer.year')}</span>
      </div>
    </div>
  </div>
</footer>
