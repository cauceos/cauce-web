---
// Nav.astro — fixed top bar with blur. Logo + anchor links + waitlist CTA.
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import LangSwitcher from './ui/LangSwitcher.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Route without locale prefix ('/', '/log'). Used by the language switch. */
  path?: string;
}

const { lang, path = '/' } = Astro.props;
const t = useTranslations(lang);

// Anchors are absolute so the nav also works from /log.
const home = getLocalizedPath('/', lang);
const links = [
  { href: `${home}#problema`, label: t('nav.problem') },
  { href: `${home}#que-es`, label: t('nav.whatIs') },
  { href: `${home}#arquitectura`, label: t('nav.stack') },
  { href: `${home}#bip`, label: t('nav.project') },
  { href: getLocalizedPath('/log', lang), label: t('nav.log') },
];

const linkClass =
  'font-body text-xs text-stone-400 hover:text-stone-100 transition-colors duration-200';
---

<nav
  class="fixed top-0 left-0 right-0 z-50 h-20 bg-[rgba(14,15,13,0.75)] backdrop-blur-xl border-b border-[var(--border)]"
>
  <div class="container-page h-full">
    <div class="flex items-center justify-between h-full">
      <!-- Left: logo + wordmark -->
      <a href={`${home}#inicio`} class="flex items-center gap-2.5 group">
        <Logo size={26} />
        <span class="font-display text-xl tracking-tight">
          Cau<em class="italic text-teal-500">ce</em>
        </span>
      </a>

      <!-- Center: anchor links (hidden under 768px) -->
      <div class="hidden md:flex items-center gap-10">
        {links.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      </div>

      <!-- Right: language switcher + primary CTA -->
      <div class="flex items-center gap-4">
        <LangSwitcher current={lang} path={path} />
        <Button href={`${home}#waitlist`} variant="primary" size="sm">{t('nav.cta')}</Button>
      </div>
    </div>
  </div>
</nav>
