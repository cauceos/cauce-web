---
// Nav.astro — fixed top bar with blur. Logo + anchor links + waitlist CTA.
import Logo from './Logo.astro';
import Button from './ui/Button.astro';

const links = [
  { href: '#problema', label: 'El problema' },
  { href: '#que-es', label: 'Qué es' },
  { href: '#arquitectura', label: 'Stack' },
  { href: '#bip', label: 'Proyecto' },
];

const linkClass =
  'font-body text-xs text-stone-400 hover:text-stone-100 transition-colors duration-200';
---

<nav
  class="fixed top-0 left-0 right-0 z-50 h-16 bg-[rgba(14,15,13,0.75)] backdrop-blur-xl border-b border-[var(--border)]"
>
  <div class="max-w-content mx-auto h-full px-5 md:px-10">
    <div class="flex items-center justify-between h-full">
      <!-- Left: logo + wordmark -->
      <a href="#inicio" class="flex items-center gap-2.5 group">
        <Logo size={26} />
        <span class="font-display text-lg tracking-tight">
          Cau<em class="italic text-teal-500">ce</em>
        </span>
      </a>

      <!-- Center: anchor links (hidden under 768px) -->
      <div class="hidden md:flex items-center gap-8">
        {links.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      </div>

      <!-- Right: primary CTA (stays visible on mobile) -->
      <Button href="#waitlist" variant="primary" size="sm">Únete a la waitlist</Button>
    </div>
  </div>
</nav>
