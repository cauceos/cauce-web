---
import { type Lang } from '../../i18n/ui';

interface Props {
  current: Lang;
}

const { current } = Astro.props;

const links: { code: Lang; label: string; href: string }[] = [
  { code: 'en', label: 'EN', href: '/' },
  { code: 'es', label: 'ES', href: '/es/' },
];
---

<div
  class="flex items-center gap-1 font-mono text-[11px] border border-[var(--border)] rounded-full px-1 py-1"
>
  {
    links.map((link) => {
      const isActive = link.code === current;
      return (
        <a
          href={link.href}
          class:list={[
            'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full transition-colors duration-200',
            isActive
              ? 'bg-[var(--color-stone-800)] text-stone-100'
              : 'text-stone-600 hover:text-stone-400',
          ]}
        >
          {isActive && (
            <span class="w-1 h-1 rounded-full bg-teal-500" aria-hidden="true"></span>
          )}
          {link.label}
        </a>
      );
    })
  }
</div>
