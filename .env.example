# Plantilla de variables de entorno.
# Copia este archivo a .env.local y rellena los valores que falten.
# .env.local NO se commitea (ver .gitignore).

PUBLIC_GITHUB_URL=https://github.com/cauceos
PUBLIC_X_URL=https://x.com/cauce_ai
PUBLIC_CONTACT_EMAIL=hola@cauce.dev

# Turso (waitlist database)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Resend (transactional email)
RESEND_API_KEY=re_your_key_here

# Admin notification
NOTIFICATION_EMAIL=admin@example.com

# Security
IP_HASH_SALT=change-this-to-random-string-in-production
